{
  "name": "cron",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "expo:doctor": "pnpm dlx expo-doctor@latest",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "build:development:android:local": "eas build --profile development --platform android --local",
    "build:preview:android:local": "eas build --profile preview --platform android --local",
    "build:production:android:local": "eas build --profile production --platform android --local",
    "nuke": "rm -rf ./node_modules && rm -rf ./ios && rm -rf ./android",
    "preinstall": "npx only-allow pnpm",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/switch": "^1.5.2",
    "@tanstack/react-form": "^1.29.1",
    "expo": "~58.0.16",
    "expo-battery": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "jotai": "^2.19.1",
    "phosphor-react-native": "^3.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-audio-api": "^0.13.6",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.14",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-plugin-react-native": "^0.2.16",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "ultracite": "^7.6.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.agents/"
    ]
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ],
    "overrides": {
      "@react-native/jest-preset": "0.88.0",
      "react-dom": "19.3.0"
    }
