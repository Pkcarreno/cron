    "@tanstack/react-form": "^1.29.1",
    "expo": "~58.0.16",
    "expo-battery": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "jotai": "^2.19.1",
    "phosphor-react-native": "^3.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-audio-api": "^0.13.6",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.14",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-plugin-react-native": "^0.2.39",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "ultracite": "^8.0.1"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
