{
  "name": "cron",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "expo:doctor": "pnpm dlx expo-doctor@latest",
    "bundle:analyze": "EXPO_ATLAS=true expo export -p android && npx expo-atlas .expo/atlas.jsonl",
    "perf:doctor": "tsx scripts/perf/doctor.ts",
    "perf:build": "tsx scripts/perf/build.ts",
    "perf:measure": "tsx scripts/perf/measure.ts",
    "perf:compare": "tsx scripts/perf/compare.ts",
    "generate:audio": "tsx scripts/audio/generate-sound-pack.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "build:development:android:local": "mkdir -p build && eas build --profile development --platform android --local --output build/app-development.apk",
    "build:preview:android:local": "mkdir -p build && eas build --profile preview --platform android --local --output build/app-preview.apk",
    "build:production:android:local": "rm -f build-*.tar.gz && eas build --profile production-apk --platform android --local && mkdir -p build && tar -zxvf build-*.tar.gz -C build/ --strip-components=3 && rm -f build-*.tar.gz",
    "nuke": "rm -rf ./node_modules && rm -rf ./ios && rm -rf ./android",
    "preinstall": "npx only-allow pnpm",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@lodev09/react-native-true-sheet": "^3.11.18",
    "cron-foreground-service": "file:./modules/cron-foreground-service",
    "expo": "~58.0.25",
    "expo-battery": "~58.0.4",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "jotai": "^2.19.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-audio-api": "^0.13.6",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.17",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "expo-atlas": "^0.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-plugin-react-native": "^0.2.43",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "ultracite": "^8.1.1"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.agents/",
      "<rootDir>/.worktrees/"
    ]
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
